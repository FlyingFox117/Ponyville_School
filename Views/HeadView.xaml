<UserControl x:Class="PonyvilleSchool2._0.Views.HeadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:voices="clr-namespace:PonyvilleSchool2._0.Services.Sounds"
             mc:Ignorable="d"
             DataContext="{Binding HeadVM}">
    <Border CornerRadius="0,0,15,15"
            Padding="5"
            Background="{Binding HeaderBrush}">
 
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- Аватар -->
            <ColumnDefinition Width="*"/>
            <!-- Сообщение -->
            <ColumnDefinition Width="Auto"/>
            <!-- Квадрат -->
        </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>
            <!-- Аватарка -->

            <Button Command="{Binding OpenProfileCommand}"
            Width="70"
            Height="70"
            Margin="15"
            Cursor="Hand"
            BorderThickness="0"
            Background="Transparent"
            voices:VoiceAssist.Phrase="openprofile"
            ToolTipService.InitialShowDelay="100">

                <Button.ToolTip>
                    <TextBlock Text="Открыть профиль"/>
                </Button.ToolTip>
                
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding UserAvatarUrl}"
                                    Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>

            </Button>

            <!--Сплэш-->
            <TextBlock Grid.Column="1"
           Text="{Binding Message}"
           VerticalAlignment="Center"
           FontSize="20"
           FontWeight="SemiBold"
           HorizontalAlignment="Center"/>

        <!--Количество заданий-->
            <Border Grid.Column="2"
        Width="50" Height="50"
        Margin="15"
        CornerRadius="10"
        Background="{Binding TaskBackground}"
        BorderBrush="{Binding TaskBorderBrush}"
        BorderThickness="1"
        ToolTipService.InitialShowDelay="100"
        voices:VoiceAssist.Phrase="taskscount">
                <Border.ToolTip>
                <TextBlock Text="Заданий осталось"/>
                </Border.ToolTip>

                <TextBlock Text="{Binding AvailableTasksCount}"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               FontSize="18"
               FontWeight="Bold"/>
        </Border>
    </Grid>
    </Border>
</UserControl>