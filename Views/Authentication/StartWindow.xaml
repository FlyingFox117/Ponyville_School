<Window x:Class="PonyvilleSchool2._0.Views.Authentication.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PonyvilleSchool2._0.ViewModels.Authentication"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:b="clr-namespace:PonyvilleSchool2._0.Core"
        xmlns:views="clr-namespace:PonyvilleSchool2._0.Views.Authentication"
        Title="{Binding CurrentWindow}" Height="500" Width="720" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:StartViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Окно авторизации -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <!-- Окно регистрации -->
        <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
            <views:RegisterView/>
        </DataTemplate>
        <!-- Окно ввода кода -->
        <DataTemplate DataType="{x:Type vm:PasswordRestoreViewModel}">
            <views:PasswordRestoreView/>
        </DataTemplate>
        <!-- Окно изменения пароля -->
        <DataTemplate DataType="{x:Type vm:NewPasswordViewModel}">
            <views:NewPasswordView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Левая часть -->
        <Image Stretch="UniformToFill" Width="367" HorizontalAlignment="Left" Source="/Assets/Authentication/friendship2.png">
            <i:Interaction.Behaviors>
                <b:ImageTransitionBehavior BoundSource="{Binding CurrentImage}" TransitionKind="FadeOutIn" DurationSeconds="1.5"/>
            </i:Interaction.Behaviors>
        </Image>
        <TextBlock
            Text="Ver. 2.0"
            Margin="5"
            VerticalAlignment="Bottom"
            Foreground="White"/>
        <!-- Правая часть -->
        <Border Grid.Column="1" CornerRadius="15 0 0 15" Width="350"  HorizontalAlignment="Right" Background="White">
            <ContentControl
            Content="{Binding CurrentView}"/>
        </Border>
    </Grid>
</Window>