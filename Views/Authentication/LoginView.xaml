<UserControl x:Class="PonyvilleSchool2._0.Views.Authentication.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:materialDesignIcons="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:PonyvilleSchool2._0.ViewModels.Authentication"
             mc:Ignorable="d">

    <StackPanel Margin="30">
        <TextBlock Text="Авторизация" FontSize="22" Margin="0 0 0 5"/>
        <!-- Сообщение пользователю -->
        <TextBlock
            Text="{Binding StatusMessage}"
            Foreground="{Binding StatusColor}"
            TextWrapping="Wrap"
             Margin="0 3 0 5"
            FontWeight="SemiBold"/>
        <!-- Поле ввода логина -->
        <TextBlock Text="Почта"/>
        <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Поле ввода пароля -->
        <TextBlock Text="Пароль" Margin="0 5 0 0"/>
        <Grid Margin="0,0,0,0" Cursor="">
            <!-- PasswordBox -->
            <PasswordBox
            x:Name="HiddenPasswordBox"
            materialDesign:PasswordBoxAssist.Password=
            "{Binding Password, Mode=TwoWay,
            UpdateSourceTrigger=PropertyChanged}">

                <PasswordBox.Style>
                    <Style TargetType="PasswordBox"
                    BasedOn="{StaticResource MaterialDesignFloatingHintPasswordBox}">

                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPasswordVisible}"
                                 Value="True">
                                <Setter Property="Visibility"
                                Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </PasswordBox.Style>
            </PasswordBox>
            <!-- TextBox -->
            <TextBox
            Text="{Binding Password,
            UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox"
                    BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">

                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPasswordVisible}"
                                 Value="True">
                                <Setter Property="Visibility"
                                Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <!-- Кнопка показа/скрытия пароля -->
            <Button Width="53" Height="32" Margin="0, 0, -15, 0"
        HorizontalAlignment="Right" VerticalAlignment="Center"
        Background="Transparent" BorderThickness="0"
        Command="{Binding TogglePasswordVisibilityCommand}">
                <materialDesign:PackIcon Width="22" Height="22" Foreground="Black">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind" Value="Eye"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                    <Setter Property="Kind" Value="EyeOff"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
            </Button>
        </Grid>

        <!-- Кнопка изменения пароля -->
        <Button
            Content="Забыли пароль?"
            Command="{Binding ResetPassword}"
            Background="Transparent"
            BorderThickness="0"
            Foreground="#5E35B1"
            Cursor="Hand"
            HorizontalAlignment="Left"
            Padding="0"
            Margin="0,8,0,0">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground"
                    Value="#5E35B1"/>
                    <Setter Property="FontWeight"
                    Value="SemiBold"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver"
                         Value="True">
                            <Setter Property="Foreground"
                            Value="#7C4DFF"/>
                            <Setter Property="TextBlock.TextDecorations"
                            Value="Underline"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <CheckBox Content="Запомнить меня" IsChecked="{Binding SaveLogin, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="-6, 0, 0, 0"/>
        <!-- Кнопка авторизации -->
        <Button Content="Войти" Command="{Binding LoginCommand}" Margin="0 10 0 15" IsEnabled="{Binding IsNotLoading}"/>
        <!-- Кнопка перехода к регистрации -->
        <Button Content="Регистрация" Command="{Binding GoToRegisterCommand}"/>
    </StackPanel>
</UserControl>