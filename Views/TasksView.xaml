<UserControl x:Class="PonyvilleSchool2._0.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <!-- Задний фон курса -->
        <Rectangle RadiusX="15"
           RadiusY="15">
            <Rectangle.Fill>
                <ImageBrush ImageSource="{Binding Background}"
                    Stretch="UniformToFill"/>
            </Rectangle.Fill>
        </Rectangle>
        
        <!-- Список -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!-- Плитки заданий -->
            <ItemsControl ItemsSource="{Binding Tasks}">
                
                <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                        <Border Width="280"
                            Margin="5"
                            Height="350"
                            Background="White"
                            CornerRadius="15"
                            BorderThickness="1"
                            BorderBrush="#DDDDDD">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Заголовок -->
                                <Grid Margin="5">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding number, StringFormat=#\{0\}}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                           Text="{Binding title}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"/>
                                </Grid>

                                <!-- Картинка -->
                                <Grid x:Name="ImageArea"
                                        Grid.Row="1"
                                        Margin="10,0"
                                        Cursor="Hand">

                                    <Grid.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenTaskCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                    </Grid.InputBindings>

                                    <Border CornerRadius="10"
                                            ClipToBounds="True">

                                        <Grid>

                                            <Image Source="{Binding image_url}"
                                                    Stretch="Uniform"/>

                                            <!-- Серый слой для закрытых заданий -->
                                            <Border Background="#AA808080">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding available}"
                                                                     Value="False">
                                                                <Setter Property="Visibility"
                                                                    Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Затемнение при наведении -->
                                            <Border Background="#66000000">

                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding available}" Value="True"/>
                                                                    <Condition Binding="{Binding IsMouseOver, ElementName=ImageArea}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Замок, если задание недоступно -->
                                            <TextBlock Text="🔒"
                                                    FontSize="42"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">

                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding available}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Кнопка "Play", если задание доступно -->
                                            <TextBlock Text="▶"
                                                        FontSize="42"
                                                        Foreground="White"
                                                        FontWeight="Bold"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">

                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding available}" Value="True"/>
                                                                    <Condition Binding="{Binding IsMouseOver, ElementName=ImageArea}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Описание -->
                                <TextBlock Grid.Row="2"
                                       Margin="10"
                                       Text="{Binding description}"
                                       TextWrapping="Wrap"
                                       MaxHeight="100"/>

                                <!-- Статус -->
                                <Border Grid.Row="3"
                                    Margin="10"
                                    Padding="8,5"
                                    CornerRadius="10"
                                    Background="{Binding status_brush}"
                                    HorizontalAlignment="Center">

                                    <TextBlock Text="{Binding status_text}"
                                           FontWeight="Bold"/>
                                </Border>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- Загрузка -->
        <Border Background="#AAFFFFFF"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Загрузка заданий..."
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>