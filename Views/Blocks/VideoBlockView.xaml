<UserControl x:Class="PonyvilleSchool2._0.Views.Blocks.VideoBlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 1. Видео -->
        <MediaElement Source="{Binding video_url}"
                  LoadedBehavior="Play"
                  UnloadedBehavior="Stop"
                  Stretch="Uniform">

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MediaEnded">
                    <behaviors:InvokeCommandAction Command="{Binding VideoEndedCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>

        </MediaElement>

        <!-- 2. Текстовая плашка с описанием снизу -->
        <TextBlock Grid.Row="1"
               Text="{Binding description}"
               Margin="10"
               FontSize="20"
               TextWrapping="Wrap"
               Foreground="White"
               Background="#AA000000"
               Padding="10"
               TextAlignment="Center"/>
    </Grid>
</UserControl>