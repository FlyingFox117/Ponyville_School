<UserControl x:Class="PonyvilleSchool2._0.Views.Blocks.TestBlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Key="clr-namespace:PonyvilleSchool2._0.Services"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Текстовый вопрос -->
        <DataTemplate x:Key="QuestionTextTemplate">
            <TextBlock Text="{Binding value}"
                       FontSize="20"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>
        </DataTemplate>

        <!-- Вопрос-картинка -->
        <DataTemplate x:Key="QuestionImageTemplate">
            <Border Margin="0,0,0,20"
                    HorizontalAlignment="Center"
                    CornerRadius="10"
                    ClipToBounds="True">
                <Image Source="{Binding value}"
                       Width="370"
                       Height="230"
                       Stretch="Uniform"/>
            </Border>
        </DataTemplate>

        <!-- Текстовый ответ -->
        <DataTemplate x:Key="AnswerTextTemplate">
            <TextBlock Text="{Binding content.value}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="18"/>
        </DataTemplate>

        <!-- Ответ-картинка -->
        <DataTemplate x:Key="AnswerImageTemplate">
            <Border CornerRadius="8"
                    ClipToBounds="True"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Image Source="{Binding content.value}"
                       Width="250"
                       Height="140"
                       Stretch="UniformToFill"/>
            </Border>
        </DataTemplate>

        <Key:TestContentTemplateSelector x:Key="QuestionTemplateSelector"
                                           TextTemplate="{StaticResource QuestionTextTemplate}"
                                           ImageTemplate="{StaticResource QuestionImageTemplate}"/>
        <Key:TestAnswerTemplateSelector x:Key="AnswerTemplateSelector"
                                          TextTemplate="{StaticResource AnswerTextTemplate}"
                                          ImageTemplate="{StaticResource AnswerImageTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="*"/>
            <!-- Центральное содержимое -->
            <RowDefinition Height="Auto"/>
            <!-- Подсказка внизу -->
        </Grid.RowDefinitions>

        <!-- 1. Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="{Binding title}"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="20,15,20,10"/>

        <!-- 2. Центральная часть: вопрос + ответы -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    Margin="10,0">

            <!-- ВОПРОС -->
            <ContentControl Content="{Binding CurrentQuestion.question}"
                            ContentTemplateSelector="{StaticResource QuestionTemplateSelector}"
                            Opacity="0"
                            HorizontalAlignment="Center">
                <ContentControl.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1"
                                                 Duration="0:0:0.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ContentControl.Triggers>
            </ContentControl>

            <!-- ОТВЕТЫ -->
            <ItemsControl ItemsSource="{Binding CurrentQuestion.answers}"
                          HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Foreground="Black"
                                Margin="0,6"
                                Width="360"
                                MinHeight="50"
                                Padding="10"
                                Background="{Binding Background}"
                                IsEnabled="{Binding IsEnabled}"
                                Command="{Binding DataContext.SelectAnswerCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand">

                            <ContentControl Content="{Binding}"
                                            ContentTemplateSelector="{StaticResource AnswerTemplateSelector}"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- 5. Описание внизу -->
        <Border Grid.Row="2"
                Background="#AA000000"
                Padding="15,10">
            <TextBlock Text="{Binding description}"
                       Foreground="White"
                       FontSize="20"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>