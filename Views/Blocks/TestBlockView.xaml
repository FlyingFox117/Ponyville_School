<UserControl x:Class="PonyvilleSchool2._0.Views.Blocks.TestBlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="*"/>
            <!-- Центральное содержимое -->
            <RowDefinition Height="Auto"/>
            <!-- Подсказка внизу -->
        </Grid.RowDefinitions>

        <!-- 1. Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="{Binding title}"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="20,15,20,10"/>

        <!-- 2. Центральная часть: вопрос + ответы -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    Margin="40,0">

            <!-- 3. Вопрос -->
            <TextBlock Text="{Binding CurrentQuestion.question}"
                       FontSize="20"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,20"
                       Opacity="0">
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1"
                                                 Duration="0:0:0.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>

            <!-- 4. Ответы (вертикальный список) -->
            <ItemsControl ItemsSource="{Binding CurrentQuestion.answers}"
                          HorizontalAlignment="Center">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding text}"
                                Foreground="Black"
                                Margin="0,6"
                                Width="360"
                                Height="50"
                                Padding="10"
                                Background="{Binding Background}"
                                IsEnabled="{Binding IsEnabled}"
                                Command="{Binding DataContext.SelectAnswerCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                FontSize="18"
                                Cursor="Hand"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- 5. Описание внизу -->
        <Border Grid.Row="2"
                Background="#AA000000"
                Padding="15,10">
            <TextBlock Text="{Binding description}"
                       Foreground="White"
                       FontSize="20"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>