<UserControl x:Class="PonyvilleSchool2._0.Views.Blocks.ResultBlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PonyvilleSchool2._0.Views.Blocks"
             mc:Ignorable="d">
    <Grid>

        <Image Source="/Assets/task_result_background.jpg"
           Stretch="UniformToFill"/>

        <!-- Центральная карточка -->
        <Border Width="400"
                MaxHeight="600"
                Padding="20"
                Margin="0,15,0,15"
                CornerRadius="25"
                Background="#FFFDFDFD"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <!-- Заголовок -->
                <TextBlock Text="Задание пройдено!"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#4A148C"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <!-- Блок результата -->
                <Border CornerRadius="15"
                        Padding="20"
                        Margin="0,0,0,5"
                        Background="#FFF5F5F5">

                    <StackPanel>

                        <TextBlock Text="Твой результат:"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,3"/>

                        <Grid Margin="0,3,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Очки -->
                            <Border Grid.Column="0"
                                Background="White"
                                CornerRadius="10"
                                Padding="15">

                                <StackPanel>

                                    <Image Source="{Binding ScoreImage}"
                                        Width="48"
                                        Height="48"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,10"/>

                                    <TextBlock Text="Очки"
                                        FontSize="18"
                                        HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding Score}"
                                        FontSize="42"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"/>
                                </StackPanel>

                            </Border>

                            <!-- Время -->
                            <Border Grid.Column="2"
                                Background="White"
                                CornerRadius="10"
                                Padding="15">

                                <StackPanel>

                                    <Image Source="/Assets/timer.png"
                                       Width="48"
                                       Height="48"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>

                                    <TextBlock Text="Время"
                                       FontSize="18"
                                       HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding Time}"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>

                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- Достижения -->
                <TextBlock Text="Полученные достижения"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,3"/>

                <Border Background="#FFFFF8E1"
                        CornerRadius="12"
                        Padding="20">
                    
                    <StackPanel>
                        <TextBlock Text="Ничего нет!"
                                   FontSize="18"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
