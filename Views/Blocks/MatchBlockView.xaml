<UserControl x:Class="PonyvilleSchool2._0.Views.Blocks.MatchBlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Key="clr-namespace:PonyvilleSchool2._0.Services"
             mc:Ignorable="d"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop">
    
    <UserControl.Resources>
        <!-- Шаблоны для отображения MatchContent (Target в слоте) -->
        <DataTemplate x:Key="ContentImageTemplate">
            <Image Source="{Binding value}" Width="120" Height="120"
               Stretch="Uniform"
               ClipToBounds="True"/>
        </DataTemplate>
        <DataTemplate x:Key="ContentTextTemplate">
            <TextBlock Text="{Binding value}" 
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   FontSize="16" FontWeight="Bold"/>
        </DataTemplate>
        <Key:ContentTemplateSelector x:Key="ContentSelector"
        ImageTemplate="{StaticResource ContentImageTemplate}"
        TextTemplate="{StaticResource ContentTextTemplate}"/>

        <!-- Шаблоны для отображения DragCard (нижняя панель и внутри слота после дропа) -->
        <DataTemplate x:Key="CardImageTemplate">
            <Image Source="{Binding Content.value}" Width="60" Height="60"
               Stretch="Uniform"
               ClipToBounds="True"/>
        </DataTemplate>
        <DataTemplate x:Key="CardTextTemplate">
            <TextBlock Text="{Binding Content.value}"
                   Padding="4" Background="White" HorizontalAlignment="Center"/>
        </DataTemplate>
        <Key:DragCardTemplateSelector x:Key="CardSelector"
        ImageTemplate="{StaticResource CardImageTemplate}"
        TextTemplate="{StaticResource CardTextTemplate}"/>
        
        <!-- Обводки карточек и панелей -->
        <SolidColorBrush x:Key="DropTargetBrush" Color="#40FFA500"/>
        <DataTemplate x:Key="DragAdorner">
            <Border Background="#88ADD8E6" BorderBrush="Blue" 
                BorderThickness="1" CornerRadius="4" Padding="6">
                <ContentControl Content="{Binding}" 
                            ContentTemplateSelector="{StaticResource CardSelector}"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    
    <Grid>
        <StackPanel>

            <TextBlock Text="{Binding title}"
                   FontSize="22"
                   HorizontalAlignment="Center"
                   Margin="10"
                   FontWeight="Bold"/>

            <!-- 1. Картинки и слоты -->
            <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10">
                            <ContentControl Content="{Binding Target}"
                                        ContentTemplateSelector="{StaticResource ContentSelector}"
                                        Width="120" Height="120" ClipToBounds="True"/>
                            <Border Height="50"
                                Background="#22000000"
                                Margin="5"
                                dd:DragDrop.IsDropTarget="True"
                                dd:DragDrop.DropTargetAdornerBrush="{StaticResource DropTargetBrush}"
                                dd:DragDrop.DropHandler="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ItemsControl ItemsSource="{Binding Cards}"
                                               dd:DragDrop.IsDragSource="True"
                                               dd:DragDrop.DragAdornerTemplate="{StaticResource DragAdorner}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="Transparent" BorderThickness="1" Margin="2">
                                                <ContentControl Content="{Binding}"
                                                ContentTemplateSelector="{StaticResource CardSelector}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 2. Объекты для перетаскивания -->
            <StackPanel MinHeight="60"
                Background="Transparent"
                dd:DragDrop.IsDropTarget="True"
                dd:DragDrop.DropHandler="{Binding}">
                <ItemsControl ItemsSource="{Binding Cards}"
                  dd:DragDrop.IsDragSource="True"
                  dd:DragDrop.DragAdornerTemplate="{StaticResource DragAdorner}"
                  dd:DragDrop.DropTargetAdornerBrush="{StaticResource DropTargetBrush}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" 
                                    CornerRadius="4" Background="White" 
                                    Margin="4" Padding="4">
                                <ContentControl Content="{Binding}"
                                ContentTemplateSelector="{StaticResource CardSelector}"
                                Margin="5"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
        
        <!-- 3. Плашка с описанием снизу -->
        <Border Background="#AA000000"
                VerticalAlignment="Bottom"
                Padding="20">
            <TextBlock Grid.Row="1"
            Text="{Binding description}"
            Margin="10"
            FontSize="20"
            TextWrapping="Wrap"
            Foreground="White"
            Padding="10"
            TextAlignment="Center"
            HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>