<Window x:Class="PonyvilleSchool2._0.Views.PonyMessage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PonyvilleSchool2._0.Views"
        xmlns:voices="clr-namespace:PonyvilleSchool2._0.Services.Sounds"
        Title="{Binding Title}" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        ResizeMode="NoResize" 
        ShowInTaskbar="False" 
        SizeToContent="WidthAndHeight" 
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=FirstButton}">

    <Border Background="White" 
            CornerRadius="15" 
            Padding="25,20" 
            Margin="10">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="5" BlurRadius="15" Opacity="0.25" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" 
                       Text="{Binding Title}" 
                       HorizontalAlignment="Center" 
                       FontSize="18" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,12"
                       Foreground="#333333"/>

            <!-- Картинка пони -->
            <Image Grid.Row="1" 
                   Source="{Binding ImagePath}" 
                   Width="80" 
                   Height="80" 
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"/>

            <!-- Сообщение -->
            <TextBlock Grid.Row="2" 
                       Text="{Binding Message}" 
                       HorizontalAlignment="Center" 
                       FontSize="14" 
                       Margin="0,0,0,20"
                       TextWrapping="Wrap" 
                       MaxWidth="350"
                       Foreground="#444444"
                       TextAlignment="Center"/>

            <!-- Поле ввода (видимо только при режиме Input) -->
            <TextBox Grid.Row="3" 
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                     Visibility="{Binding IsInputVisible}" 
                     Width="200" 
                     Height="30" 
                     Margin="0,0,0,15"
                     HorizontalAlignment="Center"/>
            
            <!-- Кнопки -->
            <StackPanel Grid.Row="4" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center">
                <!-- Кнопка OK (для режима OK) -->
                <Button Content="OK" 
                        Command="{Binding OkCommand}" 
                        Visibility="{Binding OkVisibility}"
                        voices:VoiceAssist.Phrase="accept"
                        Width="90" Height="35" Margin="5,0"/>

                <!-- Кнопки Да/Нет -->
                <Button Content="Да" 
                        Command="{Binding YesCommand}" 
                        Visibility="{Binding YesNoVisibility}" 
                        voices:VoiceAssist.Phrase="yes"
                        Width="90" Height="35" Margin="5,0"/>
                <Button Content="Нет" 
                        Command="{Binding NoCommand}" 
                        Visibility="{Binding YesNoVisibility}" 
                        voices:VoiceAssist.Phrase="no"
                        Width="90" Height="35" Margin="5,0"/>

                <!-- Кнопки ОК/Отмена для режима ввода -->
                <Button Content="ОК" 
                        Command="{Binding OkCommand}" 
                        Visibility="{Binding IsOkCancelVisible}" 
                        voices:VoiceAssist.Phrase="accept"
                        Width="90" Height="35" Margin="5,0"/>
                <Button Content="Отмена" 
                        Command="{Binding CancelCommand}" 
                        Visibility="{Binding IsOkCancelVisible}" 
                        voices:VoiceAssist.Phrase="cancel"
                        Width="90" Height="35" Margin="5,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>