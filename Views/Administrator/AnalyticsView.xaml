<UserControl x:Class="PonyvilleSchool2._0.Views.Administrator.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PonyvilleSchool2._0.Views.Administrator"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <!-- Левая панель -->
        <ListBox ItemsSource="{Binding Courses}"
                 SelectedItem="{Binding SelectedCourse}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding course_name}" FontSize="18"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Правая панель -->
        <Border Margin="350,0,0,0" Padding="20" Background="#EEE" CornerRadius="12">
            <StackPanel DataContext="{Binding SelectedCourse}">
                <TextBlock Text="Аналитика курса"
                           FontSize="26"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,15"/>
                <TextBlock Text="Самое популярное задание"
                                   FontWeight="Bold"
                                   FontSize="16"/>
                <TextBlock Text="{Binding most_popular_task}"/>
                <TextBlock Text="Задание с наименьшим средним баллом"
                                   FontWeight="Bold"
                                   FontSize="16"/>
                <TextBlock Text="{Binding least_resultive_task}"/>
                <TextBlock Text="Задание с наибольшим средним баллом"
                                   FontWeight="Bold"
                                   FontSize="16"/>
                <TextBlock Text="{Binding most_resultive_task}"/>
                <TextBlock Text="Всего заданий"
                                   FontWeight="Bold"
                                   FontSize="16"/>
                <TextBlock Text="{Binding total_tasks}"/>
                <TextBlock Text="Средний прогресс пользователей"
                                   FontWeight="Bold"
                                   FontSize="16"/>
                <TextBlock Text="{Binding average_progress}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
